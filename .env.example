# ---------------------------------------------------------------------------
# MacVoy platform environment variables
# Copy to `.env.local` and fill in. Nothing here is provisioned yet.
# ---------------------------------------------------------------------------

# Supabase (from the project's API settings once provisioned)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used by webhooks / admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Helcim (payments) — not set up yet
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_SECRET=

# Loops (email)
LOOPS_API_KEY=
# Verified sending identities
LOOPS_FROM_TRANSACTIONAL=info@macvoyirishdance.com
LOOPS_FROM_ANNOUNCEMENTS=debbie@macvoyirishdance.com
# Transactional template IDs (create these templates in Loops → Transactional)
LOOPS_TID_REGISTRATION=
LOOPS_TID_ANNOUNCEMENT=
LOOPS_TID_RECEIPT=

# Sentry (error monitoring). DSN is required; org/project/auth-token are only
# needed to upload source maps at build time (set them in Vercel).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
